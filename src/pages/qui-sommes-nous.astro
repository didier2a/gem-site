---
import { getEntry, render } from 'astro:content';
import DisplayTitle from '../components/DisplayTitle.astro';
import Site from '../layouts/Site.astro';
import { renderMarkdown } from '../lib/markdown';
import { revealClass, teamPhotoSrc } from '../lib/site-media';

const page = await getEntry('pages', 'qui-sommes-nous');
if (!page || !Array.isArray(page.data.team)) {
  throw new Error('content/pages/qui-sommes-nous.md : liste Équipe manquante.');
}
const team = page.data.team;

const { Content } = await render(page);
const introHtml = await renderMarkdown(page.data.intro);
---
<Site
  title={`${page.data.title} - GEM Casa di l’Isula`}
  description={page.data.intro?.replace(/\s+/g, ' ').trim() || page.data.title}
  current="qui"
>
  <main id="main">
    <header class="page-hero">
      <div class="container">
        <p class="eyebrow reveal">Le GEM de Porto-Vecchio, Casa di L’isula</p>
        <DisplayTitle title={page.data.title} />
        {introHtml && <div class="lead reveal reveal-delay-1 md-inline" set:html={introHtml} />}
      </div>
    </header>

    <section class="section">
      <div class="container contact-grid">
        <div class="prose-live md-content reveal">
          <p class="section-kicker">Notre maison commune</p>
          <h2 class="section-title">Ici, personne ne fait seul</h2>
          <Content />
        </div>
        <blockquote class="quote-block reveal reveal-delay-1" style="background:var(--navy);">
          <p>« Vous trouverez ci-dessous les membres du bureau et de l’équipe d’animation qui, ensemble, font vivre cette maison commune. »</p>
        </blockquote>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <p class="section-kicker reveal">Notre équipe</p>
        <h2 class="section-title reveal">Bureau &amp; animation</h2>
        <div class="team-grid" style="margin-top:1.75rem">
          {team.map((member, index) => (
            <article class={`team-card ${revealClass(index)}`}>
              <img src={teamPhotoSrc(member.photo, member.name)} alt={member.photo_alt ?? `Portrait de ${member.name}`} loading="lazy">
              <div class="body">
                <span class="tag">{member.group}</span>
                <h3>{member.name}</h3>
                <strong>{member.role}</strong>
                <p>{member.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-sand">
      <div class="container contact-grid">
        <article class="value-card reveal">
          <h2 class="section-title" style="font-size:1.6rem">Gouvernance</h2>
          <p>Le GEM est une association loi 1901, gérée par un bureau composé de membres élus. Les décisions sont prises de manière collégiale, dans un esprit de transparence et de participation.</p>
        </article>
        <article class="value-card reveal reveal-delay-1">
          <h2 class="section-title" style="font-size:1.6rem">Le rôle des adhérents</h2>
          <p>Les adhérents sont au cœur de la vie du GEM. Leur participation, leurs idées et leur engagement font vivre le lieu et permettent de construire ensemble nos activités.</p>
        </article>
      </div>
      <div class="container" style="margin-top:2rem">
        <div class="cta-band reveal">
          <h2 class="section-title">Venez nous rencontrer !</h2>
          <p class="lead" style="margin-inline:auto">Que vous souhaitiez en savoir plus, adhérer ou simplement pousser la porte, nous serons heureux de vous accueillir.</p>
          <div class="actions">
            <a class="btn btn-primary" href="/contact/">Nous contacter</a>
            <a class="btn btn-outline" href="/contact/">Nous rendre visite</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Site>
