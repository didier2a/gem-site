---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<Welcome />
</Layout>
<main>
  <!-- Hero Section -->
  <section style="padding: 3rem 1rem; text-align: center;">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">GEM Porto-Vecchio</h1>
  </section>

  <!-- Short Description -->
  <section style="max-width: 600px; margin: 0 auto 2rem auto; text-align: center;">
    <p>
      GEM Porto-Vecchio est une association dédiée à l'inclusion sociale et à l'entraide entre ses membres.
      Nous proposons un espace convivial où chacun peut participer à des activités, échanger et créer des liens.
    </p>
  </section>

  <!-- Activities Section -->
  <section style="max-width: 800px; margin: 0 auto 2rem auto; padding: 2rem 1rem;">
    <h2 style="text-align: center; margin-bottom: 1.5rem;">Nos activités</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: center;">
      <div style="flex: 1 1 200px; background: #f9f9f9; padding: 1rem; border-radius: 8px;">
        <h3 style="margin-top: 0;">Ateliers créatifs</h3>
        <p>Peinture, dessin, bricolage — exprimez votre créativité lors de nos ateliers hebdomadaires.</p>
      </div>
      <div style="flex: 1 1 200px; background: #f9f9f9; padding: 1rem; border-radius: 8px;">
        <h3 style="margin-top: 0;">Sorties & événements</h3>
        <p>Participez à des sorties culturelles, des pique-niques ou des promenades en groupe.</p>
      </div>
      <div style="flex: 1 1 200px; background: #f9f9f9; padding: 1rem; border-radius: 8px;">
        <h3 style="margin-top: 0;">Groupes de discussion</h3>
        <p>Des moments d'échange et de partage autour de thèmes variés pour renforcer les liens.</p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section style="max-width: 600px; margin: 0 auto 2rem auto; text-align: center;">
    <h2>Contact</h2>
    <p>
      Pour plus d'informations ou pour nous rejoindre, contactez-nous :
    </p>
    <p>
      Email : <a href="mailto:contact@gem-pv.fr">contact@gem-pv.fr</a><br/>
      Téléphone : <a href="tel:+33495123456">04 95 12 34 56</a>
    </p>
  </section>
</main>

<!-- Simple Footer -->
<footer style="padding: 1rem 0; background: #efefef; text-align: center; font-size: 0.95rem;">
  &copy; {new Date().getFullYear()} GEM Porto-Vecchio. Tous droits réservés.
  <!-- INSERT_YOUR_CODE -->
  <!-- Modern TailwindCSS Homepage for GEM Porto-Vecchio -->

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-tr from-orange-100 via-amber-100 to-rose-50 pt-24 pb-16 flex flex-col items-center justify-center">
    <div class="absolute top-0 left-0 w-full h-full mix-blend-multiply pointer-events-none" aria-hidden="true"></div>
    <h1 class="text-4xl md:text-6xl font-bold text-gray-800 mb-4 tracking-tight drop-shadow-lg">GEM Porto-Vecchio</h1>
    <p class="text-lg md:text-xl text-gray-600 max-w-2xl mb-8 font-medium">Un lieu d’inclusion, d’entraide et de créativité en Corse-du-Sud.</p>
    <a href="#contact" class="inline-block rounded-lg bg-orange-500 px-6 py-3 text-white font-semibold hover:bg-orange-600 transition">Nous rejoindre</a>
  </section>

  <!-- Présentation -->
  <section class="max-w-3xl mx-auto px-4 py-14 text-center">
    <h2 class="text-2xl md:text-3xl font-semibold text-gray-800 mb-4">Qui sommes-nous ?</h2>
    <p class="text-gray-700 text-lg">
      GEM Porto-Vecchio est une association dédiée à l'inclusion sociale et à l’entraide. Nous offrons un espace chaleureux où chacun·e peut participer à des activités variées, rencontrer de nouvelles personnes, partager ses expériences et tisser des liens durables dans un esprit de respect et d’écoute.
    </p>
  </section>

  <!-- Activities Cards -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">Nos activités</h2>
    <div class="grid gap-8 grid-cols-1 md:grid-cols-3">
      <div class="bg-white rounded-xl shadow-md hover:shadow-xl p-6 transition">
        <div class="flex items-center justify-center mb-4">
          <span class="bg-orange-100 text-orange-500 rounded-full p-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M4 19h16M4 15h16M4 11h16M4 7h16M4 3h16" stroke-linecap="round"/>
            </svg>
          </span>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-gray-800">Ateliers créatifs</h3>
        <p class="text-gray-600">Peinture, dessin, bricolage et autres moments pour exprimer votre créativité chaque semaine.</p>
      </div>
      <div class="bg-white rounded-xl shadow-md hover:shadow-xl p-6 transition">
        <div class="flex items-center justify-center mb-4">
          <span class="bg-amber-100 text-amber-500 rounded-full p-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 20h5v-2a3 3 0 00-3-3h-4m-6 5H2v-2a3 3 0 013-3h4m0-4v-3.586A2 2 0 0110.586 8l2.828-2.828a4 4 0 115.656 5.656L16 14v1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-gray-800">Sorties & événements</h3>
        <p class="text-gray-600">Participez à des sorties culturelles, pique-niques ou promenades conviviales en groupe.</p>
      </div>
      <div class="bg-white rounded-xl shadow-md hover:shadow-xl p-6 transition">
        <div class="flex items-center justify-center mb-4">
          <span class="bg-rose-100 text-rose-500 rounded-full p-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path d="M17 20h5v-2a3 3 0 00-3-3h-4m6 0v-2a3 3 0 00-3-3h-4M7 20H2v-2a3 3 0 013-3h4m0-4v-3.586A2 2 0 0110.586 8l2.828-2.828a4 4 0 115.656 5.656L16 14v1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <h3 class="text-xl font-semibold mb-2 text-gray-800">Groupes de discussion</h3>
        <p class="text-gray-600">Des moments d’échange autour de thèmes variés pour renforcer les liens et s’entraider.</p>
      </div>
    </div>
  </section>

  <!-- Photo Section -->
  <section class="bg-gradient-to-br from-orange-50 via-amber-50 to-rose-100 py-14">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">En images</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <img src="/photos/atelier.jpg" alt="Atelier créatif" class="h-56 w-full object-cover rounded-lg shadow"/>
        <img src="/photos/sortie.jpg" alt="Sortie en groupe" class="h-56 w-full object-cover rounded-lg shadow"/>
        <img src="/photos/discussion.jpg" alt="Groupe de discussion" class="h-56 w-full object-cover rounded-lg shadow"/>
      </div>
    </div>
  </section>

  <!-- Premium Reusable Homepage Template -->

  <!-- Header -->
  <header class="bg-white border-b border-amber-100 shadow-sm">
    <nav class="max-w-6xl mx-auto px-4 py-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="inline-block w-9 h-9 bg-gradient-to-tr from-amber-300 via-orange-200 to-rose-200 rounded-full flex items-center justify-center font-bold text-orange-700 text-2xl">G</span>
        <span class="font-semibold text-xl text-gray-800">GEM Porto-Vecchio</span>
      </div>
      <ul class="hidden md:flex gap-8 text-base font-medium text-gray-700">
        <li><a href="#hero" class="hover:text-amber-700 transition">Accueil</a></li>
        <li><a href="#introduction" class="hover:text-amber-700 transition">Présentation</a></li>
        <li><a href="#features" class="hover:text-amber-700 transition">Activités</a></li>
        <li><a href="#image-text" class="hover:text-amber-700 transition">Notre lieu</a></li>
        <li><a href="#contact" class="hover:text-amber-700 transition">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero Section -->
  <section id="hero" class="bg-gradient-to-br from-orange-50 via-amber-50 to-rose-100 py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-800 mb-2">GEM Porto-Vecchio</h1>
      <div class="text-lg text-rose-600 font-medium mb-4">Casa di L’isula</div>
      <p class="text-gray-700 text-xl mb-8 leading-relaxed">
        Un espace d’accueil chaleureux, où la convivialité et l’écoute accompagnent chaque pas. Ici, chacun·e peut se retrouver, tisser des liens en confiance et s’inventer un chemin, avec douceur et humanité, au cœur de Porto-Vecchio.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="#introduction" class="px-7 py-3 rounded-full bg-amber-600 text-white font-semibold shadow-md hover:bg-amber-700 transition focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2">
          Découvrir le GEM
        </a>
        <a href="#contact" class="px-7 py-3 rounded-full bg-white border border-amber-600 text-amber-700 font-semibold hover:bg-amber-50 transition focus:outline-none focus:ring-2 focus:ring-amber-300 focus:ring-offset-2">
          Nous contacter
        </a>
      </div>
    </div>
  </section>

  <!-- Introduction Section -->
  <section id="introduction" class="max-w-5xl mx-auto px-4 py-16">
    <div class="flex flex-col md:flex-row md:items-center gap-12">
      <div class="md:w-1/2 mb-8 md:mb-0">
        <h2 class="text-2xl md:text-3xl font-bold text-amber-700 mb-4">Un lieu vivant et bienveillant</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          Association solidaire et humaine, le GEM Porto-Vecchio est dédié à toutes celles et ceux qui veulent retrouver la simplicité du vivre-ensemble. Pas à pas, nous cheminons vers l’autonomie et la joie du collectif, à travers des moments partagés en toute dignité.
        </p>
      </div>
      <div class="md:w-1/2 flex justify-center">
        <!-- Visual Placeholder -->
        <div class="w-full h-52 sm:h-64 md:h-80 rounded-lg bg-gradient-to-tr from-amber-100 via-rose-50 to-orange-50 flex items-center justify-center shadow-inner border-2 border-dashed border-amber-200">
          <span class="text-amber-300 text-lg font-medium">Photo à venir</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="bg-gradient-to-br from-rose-50 via-orange-50 to-amber-100 py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-10 text-center">Nos activités</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <article class="bg-white rounded-2xl shadow hover:shadow-lg transition p-8 flex flex-col items-center border border-transparent hover:border-amber-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
              <path d="M15 5l4 4M16 3a2.828 2.828 0 014 4L7 20l-4 1 1-4L16 3z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-amber-700 mb-2">Peindre</h3>
          <p class="text-gray-600 text-center">
            Laisser s’exprimer la couleur, écouter le geste, et sentir le bien-être d’un temps créatif en groupe ou en solo.
          </p>
        </article>
        <article class="bg-white rounded-2xl shadow hover:shadow-lg transition p-8 flex flex-col items-center border border-transparent hover:border-amber-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-rose-400" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
              <path d="M16.5 7.5l1.09-1.09A2.5 2.5 0 1117.5 5M3 17l1.5 1.5a2.5 2.5 0 003.5-3.5L5 13m14 8.5c-.75-1.5-2.5-4-7-4s-6.25 2.5-7 4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-rose-700 mb-2">Cuisiner</h3>
          <p class="text-gray-600 text-center">
            La cuisine comme prétexte à l’échange&nbsp;: préparer, partager, déguster ensemble… et goûter à la simplicité du bonheur.
          </p>
        </article>
        <article class="bg-white rounded-2xl shadow hover:shadow-lg transition p-8 flex flex-col items-center border border-transparent hover:border-amber-200">
          <div class="mb-4">
            <svg class="w-10 h-10 text-orange-400" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
              <path d="M15 21v-2a4 4 0 00-4-4 4 4 0 00-4 4v2M19 7v3M5 7v3M12 4V3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-orange-700 mb-2">Marcher</h3>
          <p class="text-gray-600 text-center">
            Marcher ensemble, découvrir la nature de Porto-Vecchio, et ouvrir un espace pour la parole et le silence.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Image + Text Section -->
  <section id="image-text" class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto flex flex-col-reverse md:flex-row gap-12 items-center">
      <div class="md:w-1/2 mt-8 md:mt-0">
        <h2 class="text-2xl md:text-3xl font-bold text-amber-700 mb-4">Un lieu au cœur de Porto-Vecchio</h2>
        <p class="text-lg text-gray-700 leading-relaxed">
          Située au centre-ville, la Casa di L’isula invite chacun·e dans un cadre doux et lumineux, propice aux échanges et à la création.
          <br class="hidden md:block" /><br>
          Ici, chaque personne trouve sa place&nbsp;: que vous veniez avec une idée précise ou simplement pour déposer votre présence, l’équipe et les membres vous accueillent avec chaleur.
        </p>
      </div>
      <div class="md:w-1/2 flex justify-center">
        <div class="w-full h-52 sm:h-64 md:h-80 rounded-lg bg-gradient-to-tr from-orange-100 via-amber-50 to-rose-50 flex items-center justify-center shadow-inner border-2 border-dashed border-amber-200">
          <span class="text-amber-300 text-lg font-medium">Image du lieu (à venir)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Call To Action Section -->
  <section class="bg-gradient-to-br from-orange-50 via-amber-50 to-rose-100 py-16 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">
        Rejoignez-nous à Porto-Vecchio
      </h2>
      <p class="text-lg md:text-xl text-gray-700 mb-8 leading-relaxed">
        Prêt·e à franchir le pas&nbsp;? Passez nous voir à la Casa di L’isula ou contactez-nous pour un premier échange dans la convivialité et le respect.
      </p>
      <a href="#contact" class="inline-block px-7 py-3 rounded-full bg-amber-600 text-white font-semibold shadow hover:bg-amber-700 transition focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2">
        Prendre rendez-vous
      </a>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="bg-white py-14 px-4">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-amber-700 mb-4">Contact</h2>
      <p class="text-gray-700 text-lg mb-8">
        Pour tout renseignement, une visite, ou simplement échanger, contactez-nous.<br>
        Nous vous répondrons avec plaisir et disponibilité.
      </p>
      <div class="flex flex-col items-center gap-5">
        <a href="mailto:contact@gem-pv.fr" class="flex items-center gap-2 text-orange-600 font-medium hover:underline focus:outline-none focus:text-orange-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 12l-4-4-4 4m8 0v6a2 2 0 01-2 2H6a2 2 0 01-2-2v-6"></path>
          </svg>
          contact@gem-pv.fr
        </a>
        <a href="tel:+33495123456" class="flex items-center gap-2 text-orange-600 font-medium hover:underline focus:outline-none focus:text-orange-800 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M3 5v4c5.523 0 10 4.477 10 10h4a1 1 0 001-1v-2c0-.265-.105-.52-.293-.707l-2-2A1 1 0 0015 15v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 00.293.707l2 2a1 1 0 001.414 0l2-2A1 1 0 0017 15v-4c0-6.627-5.373-12-12-12z"/>
          </svg>
          04 95 12 34 56
        </a>
        <div class="text-gray-600 font-medium mt-3">
          Porto-Vecchio, Corse
        </div>
      </div>
    </div>
  </section>

  <!-- Elegant Footer -->
  <footer class="bg-amber-50 border-t border-amber-100">
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row justify-between items-center gap-4 text-gray-500 text-sm">
      <div>© {new Date().getFullYear()} GEM Porto-Vecchio — Casa di L’isula. Tous droits réservés.</div>
      <div>
        <a href="#hero" class="hover:text-amber-700 transition">Retour en haut</a>
      </div>
    </div>
  </footer>
      <span class="block mb-1 font-medium text-amber-700">Adresse&nbsp;:</span>
      <span class="block mb-1">Porto-Vecchio, Corse</span>
      <span class="block">contact@gem-pv.fr</span>
    </div>
  </section>