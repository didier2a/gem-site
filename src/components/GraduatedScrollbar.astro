---
/**
 * Colonne graduée (filigrane) — barre de défilement discrète à droite.
 * Markup + script : le JS découvre les <section> / .page-hero de la page.
 * Loupe sous le doigt / souris ; absent de /admin/.
 */
---
<aside
  class="gem-ruler"
  id="gem-ruler"
  role="scrollbar"
  aria-orientation="vertical"
  aria-controls="main"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Position de lecture"
  hidden
>
  <div class="gem-ruler__rail" data-gem-ruler-rail>
    <div class="gem-ruler__ticks" aria-hidden="true"></div>
    <div class="gem-ruler__segments" data-gem-ruler-segments aria-hidden="true"></div>
    <div class="gem-ruler__loupe" data-gem-ruler-loupe aria-hidden="true"></div>
    <div class="gem-ruler__thumb" data-gem-ruler-thumb aria-hidden="true"></div>
  </div>
  <p class="gem-ruler__live" data-gem-ruler-live aria-live="polite"></p>
</aside>
<script src="/js/scroll-nav.js?v=5" defer></script>
