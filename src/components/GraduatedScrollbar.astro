---
/**
 * Colonne graduée 3c — traits marqués, loupe, rond « Revenir en haut »,
 * libellé de section au toucher/survol (style ancien scroll-progress-tip).
 */
---
<aside
  class="gem-ruler"
  id="gem-ruler"
  role="scrollbar"
  aria-orientation="vertical"
  aria-controls="main"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Position de lecture"
  hidden
>
  <button
    type="button"
    class="gem-ruler__knob"
    data-gem-ruler-knob
    aria-label="Revenir en haut"
  >
    <span class="gem-ruler__knob-inner" aria-hidden="true"></span>
  </button>
  <div class="gem-ruler__rail" data-gem-ruler-rail>
    <div class="gem-ruler__progress" data-gem-ruler-progress aria-hidden="true"></div>
    <svg class="gem-ruler__svg" data-gem-ruler-svg aria-hidden="true"></svg>
    <div class="gem-ruler__thumb" data-gem-ruler-thumb aria-hidden="true"></div>
    <div class="gem-ruler__tip" data-gem-ruler-tip aria-hidden="true"></div>
  </div>
  <p class="gem-ruler__live" data-gem-ruler-live aria-live="polite"></p>
</aside>
<script src="/js/scroll-nav.js?v=10" defer></script>
