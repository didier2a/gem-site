---
interface Props {
  title: string;
  description: string;
  current?: 'qui' | 'activites' | 'blog' | 'soutenir' | '';
}

const { title, description, current = '' } = Astro.props;

const nav = [
  { href: '/', label: 'Accueil', id: 'accueil' },
  { href: '/qui-sommes-nous/', label: 'Qui sommes-nous ?', id: 'qui' },
  { href: '/nos-activites/', label: 'Nos activités', id: 'activites' },
  { href: '/blog/', label: 'Blog', id: 'blog' },
  { href: '/nous-soutenir/', label: 'Nous soutenir', id: 'soutenir' },
  { href: '/contact/', label: 'Contact', id: 'contact' },
];
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/png" href="/assets/logo/logo-casa-gem.png">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/logo/logo-casa-gem.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oregano&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/editorial.css?v=22">
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Accueil GEM Casa di l’Isula">
        <img src="/assets/logo/logo-casa-gem.png" alt="" width="48" height="48">
        <span>
          <strong>GEM Casa di l’Isula</strong>
          <small>Porto-Vecchio</small>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="main-menu" aria-expanded="false" aria-label="Ouvrir le menu">
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
        Menu
      </button>
      <nav id="main-menu" class="main-nav" aria-label="Navigation principale">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="footer-social-top">
      <div class="container footer-social" aria-label="Réseaux sociaux">
        <a href="https://www.facebook.com/GEMcasadilisula" target="_blank" rel="noreferrer noopener" aria-label="Facebook">
          <img src="/assets/social/facebook.png" alt="" width="40" height="40" loading="lazy" decoding="async">
        </a>
        <a href="https://www.instagram.com" target="_blank" rel="noreferrer noopener" aria-label="Instagram">
          <img src="/assets/social/instagram.png" alt="" width="40" height="40" loading="lazy" decoding="async">
        </a>
      </div>
    </div>
    <div class="container footer-grid">
      <div>
        <img class="footer-logo" src="/assets/logo/logo-casa-gem.png" alt="Logo GEM Casa di l’Isula" width="72" height="72">
        <h2>GEM Casa di l’Isula</h2>
        <p>Un lieu d’accueil, d’entraide et de convivialité pour rompre l’isolement et recréer du lien social à Porto-Vecchio.</p>
      </div>
      <nav aria-label="Navigation de pied de page">
        <a href="/">Accueil</a>
        <a href="/qui-sommes-nous/">Qui sommes-nous ?</a>
        <a href="/nos-activites/">Nos activités</a>
        <a href="/blog/">Blog</a>
        <a href="/nous-soutenir/">Nous soutenir</a>
        <a href="/contact/">Contact</a>
        <a href="/mentions-legales/">Mentions légales</a>
      </nav>
      <address>
        <span>Immeuble Saint-Jean</span>
        <span>Quartier Poretta</span>
        <span>Avenue de Bastia</span>
        <span>20137 Porto-Vecchio</span>
        <a href="tel:+33631754145">06 31 75 41 45</a>
        <a href="mailto:gempv@laposte.net">gempv@laposte.net</a>
      </address>
    </div>
    <div class="container footer-bottom">
      <span>© GEM Casa di l’Isula — Association loi 1901</span>
      <span>Lun–ven sauf mercredi · 9h–16h</span>
    </div>
  </footer>
  <script src="/js/editorial.js?v=2" defer></script>

  <nav class="scroll-progress" id="scroll-nav" aria-label="Progression de lecture">
    <div class="scroll-progress-track" aria-hidden="true">
      <div class="scroll-progress-fill" id="scroll-progress-fill"></div>
    </div>
    <div class="scroll-progress-marks" role="list">
      <button type="button" class="scroll-progress-mark" data-section="accueil" data-home="#accueil" data-href="/#accueil" aria-label="Accueil" role="listitem"><span class="scroll-progress-tip">Accueil</span></button>
      <button type="button" class="scroll-progress-mark" data-section="qui-sommes-nous" data-home="#qui-sommes-nous" data-href="/qui-sommes-nous/" aria-label="Qui sommes-nous" role="listitem"><span class="scroll-progress-tip">Qui sommes-nous</span></button>
      <button type="button" class="scroll-progress-mark" data-section="activites" data-home="#activites" data-href="/nos-activites/" aria-label="Nos activités" role="listitem"><span class="scroll-progress-tip">Nos activités</span></button>
      <button type="button" class="scroll-progress-mark" data-section="blog" data-home="#blog" data-href="/blog/" aria-label="Blog" role="listitem"><span class="scroll-progress-tip">Blog</span></button>
      <button type="button" class="scroll-progress-mark" data-section="soutenir" data-home="#soutenir" data-href="/nous-soutenir/" aria-label="Nous soutenir" role="listitem"><span class="scroll-progress-tip">Nous soutenir</span></button>
      <button type="button" class="scroll-progress-mark" data-section="contact" data-home="#contact" data-href="/contact/" aria-label="Contact" role="listitem"><span class="scroll-progress-tip">Contact</span></button>
    </div>
    <p class="scroll-progress-live" id="scroll-progress-live" aria-live="polite"></p>
  </nav>
  <script src="/js/scroll-nav.js?v=3" defer></script>
</body>
</html>
