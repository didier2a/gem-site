{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gem-casa-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    // Produit par `npm run build` (Astro). public/ est copié dans dist/,
    // avec le blog et les pages Markdown générés par-dessus. Pas de deploy dans cette phase.
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "RESEND_FROM": "GEM Casa di l’Isula <contact@infoserv2a.pro>"
    // "RESEND_TO": "gempv@laposte.net"  // décommenter / setter pour bascule asso (sinon infoserv2a@gmail.com)
  }
  // Secrets (jamais dans git, Worker gem-casa-preview seulement) :
  // ADMIN_SESSION_SECRET, ADMIN_USERS, GITHUB_CONTENT_PAT,
  // GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET,
  // ADMIN_BOOTSTRAP_TOKEN (optionnel), RESEND_API_KEY,
  // ADMIN_SUPERADMIN_EMAIL, ADMIN_NOTIFY_EMAIL, ADMIN_GITHUB_LOGINS,
  // CF_API_TOKEN et CF_ACCOUNT_ID (optionnels : mise à jour auto de ADMIN_USERS).
  //
  // Jeton « mot de passe oublié » (1 h, usage unique). Créer le namespace puis coller l’id :
  //   npx wrangler kv namespace create ADMIN_RESET_KV
  // "kv_namespaces": [
  //   { "binding": "ADMIN_RESET_KV", "id": "<id retourné par la commande>" }
  // ]
}
